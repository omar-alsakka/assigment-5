datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  user
  admin
}

// Part 1: Using Prisma, define the Users model.
// Users fields: id, name, email unique, password, role enum, createdAt, updatedAt.
// Must implemented: validate email format in API, validate password length greater than 6,
// and validate user name length greater than 2 before creating a user.
model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  role      Role      @default(user)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  posts     Post[]
  comments  Comment[]
}

// Part 1: Using Prisma, define the Posts model.
// Posts fields: id, title, content, userId foreign key to Users, createdAt, updatedAt.
// Soft-delete is implemented with deletedAt because Prisma does not have Sequelize paranoid.
model Post {
  id        Int       @id @default(autoincrement())
  title     String
  content   String    @db.Text
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  comments  Comment[]
}

// Part 1: Using Prisma, define the Comments model.
// Comments fields: id, content, postId foreign key to Posts, userId foreign key to Users,
// createdAt, and updatedAt.
model Comment {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  postId    Int
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
